[Unit]
Description=DockCast nightly archive of live raw rows (PRD 18.4)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ubuntu is in the docker group and owns the rclone config (~/.config/rclone/rclone.conf)
User=ubuntu
Environment=REPO_DIR=/opt/dockcast
ExecStart=/opt/dockcast/deploy/oracle/archive.sh
