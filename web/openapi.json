          }
        },
        "required": [
          "station_key",
          "horizon_min",
          "issued_at",
          "alternatives"
        ],
        "title": "StationAlternatives",
        "type": "object"
      },
      "StationDrivers": {
        "description": "``GET /v1/stations/{station_key}/drivers``, sorted by absolute contribution.",
        "properties": {
          "drivers": {
            "items": {
              "$ref": "#/components/schemas/Driver"
            },
            "title": "Drivers",
            "type": "array"
          },
          "horizon_min": {
            "title": "Horizon Min",
            "type": "integer"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "station_key": {
            "title": "Station Key",
            "type": "integer"
          }
        },
        "required": [
          "station_key",
          "horizon_min",
          "issued_at",
          "drivers"
        ],
        "title": "StationDrivers",
        "type": "object"
      },
      "StationForecast": {
        "description": "``GET /v1/stations/{station_key}/forecast`` (PRD 15.2).",
        "properties": {
          "capacity": {
            "title": "Capacity",
            "type": "integer"
          },
          "data_freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "forecasts": {
            "items": {
              "$ref": "#/components/schemas/HorizonForecast"
            },
            "title": "Forecasts",
            "type": "array"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "now": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Status"
              },
              {
                "type": "null"
              }
            ]
          },
          "risk": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Risk"
              },
              {
                "type": "null"
              }
            ]
          },
          "station_key": {
            "title": "Station Key",
            "type": "integer"
          }
        },
        "required": [
          "station_key",
          "name",
          "capacity",
          "issued_at",
          "model_version",
          "now",
          "forecasts",
          "risk",
          "data_freshness"
        ],
        "title": "StationForecast",
        "type": "object"
      },
      "StationHistory": {
        "description": "``GET /v1/stations/{station_key}/history``.",
        "properties": {
          "hours": {
            "title": "Hours",
            "type": "integer"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            },
            "title": "Points",
            "type": "array"
          },
          "station_key": {
            "title": "Station Key",
            "type": "integer"
          }
        },
        "required": [
          "station_key",
          "hours",
          "points"
        ],
        "title": "StationHistory",
        "type": "object"
      },
      "Status": {
        "description": "Latest observed status of a station.",
        "properties": {
          "bikes": {
            "title": "Bikes",
            "type": "integer"
          },
          "docks": {
            "title": "Docks",
            "type": "integer"
          },
          "is_renting": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Renting"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          }
        },
        "required": [
          "bikes",
          "docks",
          "observed_at",
          "is_renting"
        ],
        "title": "Status",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DockCast API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Database reachability and freshness of the collector and the forecast job.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health"
      }
    },
    "/v1/cities": {
      "get": {
        "description": "Cities with centre and zoom.",
        "operationId": "list_cities_v1_cities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/City"
                  },
                  "title": "Response List Cities V1 Cities Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Cities"
      }
    },
    "/v1/cities/{city}/netflow": {
      "get": {
        "description": "Net change in bikes per station over ``window`` minutes (PRD 10.6), not trips.",
        "operationId": "city_net_flow_v1_cities__city__netflow_get",
        "parameters": [
          {
            "in": "path",
            "name": "city",
            "required": true,
            "schema": {
              "title": "City",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "default": 60,
              "maximum": 120,
              "minimum": 15,
              "multipleOf": 15,
              "title": "Window",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityNetFlow"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "City Net Flow"
      }
    },
    "/v1/cities/{city}/risk": {
      "get": {
        "description": "Stations ranked by empty or full risk at ``window`` minutes (interim, forecast range).",
        "operationId": "city_risk_v1_cities__city__risk_get",
        "parameters": [
          {
            "in": "path",
            "name": "city",
            "required": true,
            "schema": {
              "title": "City",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "window",
            "required": false,
            "schema": {
              "default": 60,
              "title": "Window",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "default": "empty",
              "enum": [
                "empty",
                "full"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityRisk"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "City Risk"
      }
    },
    "/v1/cities/{city}/stations": {
      "get": {
        "description": "All stations of a city with their latest status.",
        "operationId": "list_stations_v1_cities__city__stations_get",
        "parameters": [
          {
            "in": "path",
            "name": "city",
            "required": true,
            "schema": {
              "title": "City",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  },
                  "title": "Response List Stations V1 Cities  City  Stations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Stations"
      }
    },
    "/v1/model/backtest": {
      "get": {
        "description": "Rows from ``backtest_results``, averaged over folds (default: the newest full run).",
        "operationId": "model_backtest_v1_model_backtest_get",
        "parameters": [
          {
            "in": "query",
            "name": "experiment",
            "required": false,
            "schema": {
              "default": "E1",
              "title": "Experiment",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "slice_kind",
            "required": false,
            "schema": {
              "default": "overall",
              "title": "Slice Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Backtest"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Model Backtest"
      }
    },
    "/v1/model/error-analysis": {
      "get": {
        "description": "Slices pre-computed by ``make error-analysis`` (``reports/error_analysis.json``).",
        "operationId": "model_error_analysis_v1_model_error_analysis_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorAnalysis"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Error Analysis"
      }
    },
    "/v1/model/summary": {
      "get": {
        "description": "Champion versions, last retrain, backtest metrics (with E1 run id) and data health.",
        "operationId": "model_summary_v1_model_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Summary"
      }
    },
    "/v1/stations/{station_key}": {
      "get": {
        "description": "One station with its latest status.",
        "operationId": "get_station_v1_stations__station_key__get",
        "parameters": [
          {
            "in": "path",
            "name": "station_key",
            "required": true,
            "schema": {
              "title": "Station Key",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Station"
      }
    },
    "/v1/stations/{station_key}/alternatives": {
      "get": {
        "description": "The 2 nearest stations with P50 >= 3 bikes at ``horizon`` (PRD 15.1, 16.4).",
        "operationId": "station_alternatives_v1_stations__station_key__alternatives_get",
        "parameters": [
          {
            "in": "path",
            "name": "station_key",
            "required": true,
            "schema": {
              "title": "Station Key",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "horizon",
            "required": false,
            "schema": {
              "default": 30,
              "title": "Horizon",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationAlternatives"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Station Alternatives"
      }
    },
    "/v1/stations/{station_key}/drivers": {
      "get": {
        "description": "TreeSHAP feature-group drivers of the latest P50 forecast, largest first (PRD 16.4).",
        "operationId": "station_drivers_v1_stations__station_key__drivers_get",
        "parameters": [
          {
            "in": "path",
            "name": "station_key",
            "required": true,
            "schema": {
              "title": "Station Key",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "horizon",
            "required": false,
            "schema": {
              "default": 60,
              "title": "Horizon",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationDrivers"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Station Drivers"
      }
    },
    "/v1/stations/{station_key}/forecast": {
      "get": {
        "description": "Latest P10/P50/P90 forecasts at +30/+60/+120 (PRD 15.2); 503 when stale.",
        "operationId": "get_forecast_v1_stations__station_key__forecast_get",
        "parameters": [
          {
            "in": "path",
            "name": "station_key",
            "required": true,
            "schema": {
              "title": "Station Key",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationForecast"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Forecast"
      }
    },
    "/v1/stations/{station_key}/history": {
      "get": {
        "description": "15-min states for the chart (PRD 16.4), ending at the newest bucket.",
        "operationId": "station_history_v1_stations__station_key__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "station_key",
            "required": true,
            "schema": {
              "title": "Station Key",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "hours",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 48,
              "minimum": 1,
              "title": "Hours",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationHistory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Station History"
      }
    }
  }
}
