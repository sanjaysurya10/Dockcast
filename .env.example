# Copy to .env and adjust. No secrets in git. Validated at startup by dockcast/config.py.

# SQLAlchemy URL for Postgres. Port must match POSTGRES_PORT below.
DATABASE_URL=postgresql+psycopg://dockcast:dockcast@localhost:5432/dockcast
# Host port docker-compose publishes Postgres on (change if 5432 is already in use).
POSTGRES_PORT=5432
# City code; must match a file in config/cities/.
CITY=dublin
# GBFS root (gbfs.json) URL; overrides config/cities/<city>.toml. Filled in M1 after discovery.
GBFS_ROOT_URL=
# Met Éireann point forecast endpoint (PRD 5.1 D3).
MET_FORECAST_URL=http://metwdb-openaccess.ichec.ie/metno-wdb2ts/locationforecast
# MLflow tracking store.
MLFLOW_TRACKING_URI=file:./mlruns
# Optional object storage URL for the raw Parquet archive (PRD 18.4).
ARCHIVE_BUCKET_URL=
# Comma-separated list of allowed frontend origins.
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
